{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campusplace-og",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public"
  },
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": ["**/*.png", "**/*.jpg", "**/*.jpeg"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}